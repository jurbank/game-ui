{
  "name": "@gameui/react",
  "version": "0.1.0",
  "description": "Screen-space React components for Game UI.",
  "keywords": [
    "accessibility",
    "components",
    "game-ui",
    "gamedev",
    "hud",
    "react"
  ],
  "homepage": "https://github.com/jurbank/game-ui/tree/master/packages/react#readme",
  "bugs": {
    "url": "https://github.com/jurbank/game-ui/issues"
  },
  "license": "MIT",
  "author": "John Urbank",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurbank/game-ui.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@gameui/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./styles.css": {
      "@gameui/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tailwindcss --input src/styles.css --output dist/styles.css",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@gameui/core": "workspace:^",
    "@gameui/themes": "workspace:^"
  },
  "devDependencies": {
    "@tailwindcss/cli": "catalog:",
    "@tailwindcss/node": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^26.1.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
