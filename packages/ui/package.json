{
  "name": "@gameui/ui",
  "version": "0.0.0",
  "description": "Themeable UI for browser games: semantic tokens and themes, screen-space React components, and engine-independent world UI contracts.",
  "keywords": [
    "accessibility",
    "components",
    "design-tokens",
    "game-ui",
    "gamedev",
    "hud",
    "nameplate",
    "react",
    "tailwindcss",
    "theme",
    "world-ui"
  ],
  "homepage": "https://github.com/jurbank/game-ui/tree/master/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/jurbank/game-ui/issues"
  },
  "license": "MIT",
  "author": "John Urbank",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurbank/game-ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src/css",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@gameui/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "@gameui/source": "./src/react/index.ts",
      "default": "./dist/react.mjs"
    },
    "./styles.css": {
      "@gameui/source": "./src/react/styles.css",
      "default": "./dist/styles.css"
    },
    "./themes.css": "./src/css/index.css",
    "./tokens.css": "./src/css/tokens.css",
    "./base.css": "./src/css/base.css",
    "./tailwind.css": "./src/css/tailwind.css",
    "./themes/arcade.css": "./src/css/themes/arcade.css",
    "./themes/tactical.css": "./src/css/themes/tactical.css",
    "./themes/playful.css": "./src/css/themes/playful.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./react": "./dist/react.mjs",
      "./styles.css": "./dist/styles.css",
      "./themes.css": "./src/css/index.css",
      "./tokens.css": "./src/css/tokens.css",
      "./base.css": "./src/css/base.css",
      "./tailwind.css": "./src/css/tailwind.css",
      "./themes/arcade.css": "./src/css/themes/arcade.css",
      "./themes/tactical.css": "./src/css/themes/tactical.css",
      "./themes/playful.css": "./src/css/themes/playful.css",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tailwindcss --input src/react/styles.css --output dist/styles.css",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@base-ui/react": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/cli": "catalog:",
    "@tailwindcss/node": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^26.1.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
